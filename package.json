{
  "name": "photo-tools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev:photo-selector-app",
    "dev:console": "npm --workspace @photo-tools/filex-dev-console run start",
    "console": "npm --workspace @photo-tools/filex-dev-console run dev",
    "dev:image-party-frame": "npm --workspace @photo-tools/filex-desktop run dev:image-party-frame",
    "dev:photo-selector-app": "npm --workspace @photo-tools/filex-desktop run dev:photo-selector-app",
    "dev:archivio-flow": "npm --workspace @photo-tools/filex-desktop run dev:archivio-flow",
    "audit:photo-selector": "powershell -ExecutionPolicy Bypass -File scripts/audit-photo-selector.ps1",
    "test:photo-selector-workflow": "tsx scripts/test-photo-selector-workflow.ts",
    "test:photo-selector-relocation": "tsx scripts/test-photo-selector-relocation.ts",
    "test:photo-selector-xmp": "tsx scripts/test-photo-selector-xmp.ts",
    "test:archivio-flow-bug-hunt": "npm --workspace @photo-tools/archivio-flow run test:bug-hunt",
    "test:archivio-flow-package-runtime": "node scripts/test-archivio-flow-package-runtime.mjs",
    "test:image-party-frame-bug-hunt": "tsx --test apps/image-party-frame/src/app/contexts/project-state.bug.test.ts",
    "test:batch-print-layout-bug-hunt": "npm --workspace @photo-tools/batch-print-layout run test",
    "test:image-converter-bug-hunt": "tsx --test apps/filex-desktop/src/image-converter-policy.bug.test.ts",
    "test:image-file-finder-bug-hunt": "tsx --test scripts/test-image-file-finder-bug-hunt.ts",
    "test:cache-sweep-bug-hunt": "npm --workspace @photo-tools/cache-sweep run test",
    "test:filex-send-bug-hunt": "npm --workspace @photo-tools/filex-send run test",
    "test:filex-send-upload": "tsx --test apps/filex-send-web/upload-protocol.test.ts",
    "test:backup-guard-bug-hunt": "npm --workspace @photo-tools/backup-guard run test",
    "test:filex-updater-lock": "node scripts/test-filex-updater-lock.mjs",
    "test:filex-update-shutdown": "node scripts/test-filex-update-shutdown.mjs",
    "test:filex-process-snapshot-cache": "tsx --test apps/filex-desktop/src/process-snapshot-cache.test.ts",
    "test:filex-installer-runner": "tsx --test apps/filex-desktop/src/windows-installer-runner.test.ts",
    "test:filex-cooperative-signal": "tsx --test apps/filex-desktop/src/cooperative-process-signal.test.ts",
    "test:filex-suite-package-imports": "node scripts/test-filex-suite-package-imports.mjs",
    "test:filex-independent-releases": "node scripts/test-filex-independent-releases.mjs",
    "test:filex-component-release-flow": "node scripts/test-component-release-flow.mjs",
    "release:prepare-filex-suite-clean-install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-filex-suite-clean-install.ps1 -Apply",
    "release:prepare-filex-full-clean-test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-filex-full-clean-test.ps1 -Apply",
    "dev:batch-print-layout": "npm --workspace @photo-tools/filex-desktop run dev:batch-print-layout",
    "dev:image-converter": "npm --workspace @photo-tools/filex-desktop run dev:image-converter",
    "dev:image-file-finder": "npm --workspace @photo-tools/filex-desktop run dev:image-file-finder",
    "dev:cache-sweep": "npm --workspace @photo-tools/filex-desktop run dev:cache-sweep",
    "dev:filex-send": "npm --workspace @photo-tools/filex-desktop run dev:filex-send",
    "dev:backup-guard": "npm --workspace @photo-tools/filex-desktop run dev:backup-guard",
    "dev:filex-send-remote-server": "npm --workspace @photo-tools/filex-send-remote-server run dev",
    "build:filex-cloud": "npm --workspace @photo-tools/filex-cloud-functions run build",
    "test:filex-cloud": "npm --workspace @photo-tools/filex-cloud-functions run test",
    "test:filex-license-coverage": "tsx scripts/test-filex-license-coverage.ts",
    "license:status": "node scripts/filex-license-admin.mjs status",
    "license:observe": "node scripts/filex-license-admin.mjs enforcement observe",
    "license:bootstrap-commerce": "node scripts/bootstrap-paypal-commerce.mjs",
    "license:bootstrap-paypal": "node scripts/bootstrap-paypal-commerce.mjs",
    "license:create-sandbox-account": "node scripts/create-filex-sandbox-account.mjs",
    "license:bootstrap-lemonsqueezy-legacy": "node scripts/bootstrap-filex-commerce.mjs",
    "deploy:filex-cloud": "firebase deploy --project gen-lang-client-0321087169 --only functions:filex-cloud,hosting:filex-send,firestore",
    "deploy:website": "firebase deploy --project gen-lang-client-0321087169 --only hosting:filex-website",
    "website:update-suite-download": "node scripts/update-website-suite-download.mjs",
    "dev:filex-desktop:suite": "npm --workspace @photo-tools/filex-desktop run start:suite",
    "build:filex-desktop:photo-selector": "npm --workspace @photo-tools/filex-desktop run build:photo-selector",
    "build:cache-sweep": "npm --workspace @photo-tools/filex-desktop run build:cache-sweep",
    "build:filex-send": "npm --workspace @photo-tools/filex-desktop run build:filex-send",
    "build:backup-guard": "npm --workspace @photo-tools/filex-desktop run build:backup-guard",
    "build:filex-send-remote-server": "npm --workspace @photo-tools/filex-send-remote-server run build",
    "build:filex-desktop:suite": "npm --workspace @photo-tools/filex-desktop run build:suite",
    "dist:filex-desktop:photo-selector:win": "npm --workspace @photo-tools/filex-desktop run dist:photo-selector:win",
    "dist:cache-sweep:win": "npm --workspace @photo-tools/filex-desktop run dist:cache-sweep:win",
    "dist:filex-send:win": "npm --workspace @photo-tools/filex-desktop run dist:filex-send:win",
    "dist:filex-send:portable": "npm --workspace @photo-tools/filex-desktop run dist:filex-send:portable",
    "dist:backup-guard:win": "npm --workspace @photo-tools/filex-desktop run dist:backup-guard:win",
    "dist:filex-desktop:image-converter:win": "npm --workspace @photo-tools/filex-desktop run dist:image-converter:win",
    "dist:filex-desktop:image-file-finder:win": "npm --workspace @photo-tools/filex-desktop run dist:image-file-finder:win",
    "dist:filex-desktop:batch-print-layout:win": "npm --workspace @photo-tools/filex-desktop run dist:batch-print-layout:win",
    "dist:filex-desktop:suite:win": "npm --workspace @photo-tools/filex-desktop run dist:suite:win",
    "dist:filex-desktop:all-tools:win": "npm --workspace @photo-tools/filex-desktop run dist:all-tools:win",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^24.0.0",
    "firebase-tools": "^15.27.0",
    "typescript": "^5.8.0"
  },
  "allowScripts": {
    "@firebase/util": true,
    "@tailwindcss/oxide": true,
    "core-js": true,
    "electron": true,
    "esbuild": true,
    "protobufjs": true,
    "re2": true,
    "sharp": true,
    "ffmpeg-static@5.3.0": true
  }
}
