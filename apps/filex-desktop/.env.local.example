# Copia questo file come .env.local per abilitare Google Drive nelle build locali.
# Il Client ID deve appartenere al client OAuth "Desktop app" ufficiale FileX.
IMAGE_SELECT_GOOGLE_CLIENT_ID=

# Il client OAuth Desktop Google richiede anche il proprio Client Secret.
# Mantienilo fuori dal repository e usa un secret GitHub per le release.
IMAGE_SELECT_GOOGLE_CLIENT_SECRET=
