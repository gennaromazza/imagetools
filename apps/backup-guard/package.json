{
  "name": "@photo-tools/backup-guard",
  "private": true,
  "version": "0.2.5",
  "description": "FileX Backup Guard: verified master and clone archive protection.",
  "type": "module",
  "main": "../filex-desktop/.output/electron/backup-guard/electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4255",
    "start": "npm run build && electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "tsx --test electron/backup-guard-service.test.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "41.0.4",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  }
}
